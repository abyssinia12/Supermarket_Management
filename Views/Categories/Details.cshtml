@model SuperMarket.Models.Category

@{
    ViewData["Title"] = "Category Details: " + Model.CategoryName;
    var products = ViewBag.Products as List<SuperMarket.Models.ViewModels.ProductListViewModel> ?? new();
}

<div class="container my-4" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Categories</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.CategoryName</li>
        </ol>
    </nav>

    <!-- Category Header Card -->
    <div class="card shadow-sm border-1 rounded-2 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">
                <i class="bi bi-tag text-primary me-2"></i> @Model.CategoryName
            </h5>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
                <a asp-controller="Products" asp-action="Create" asp-route-categoryId="@Model.CategoryId" class="btn btn-sm btn-success">
                    <i class="bi bi-plus-circle me-1"></i> Add Product Here
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Category Name:</dt>
                <dd class="col-sm-9 fw-bold text-dark fs-6">@Model.CategoryName</dd>

                <dt class="col-sm-3 text-muted">Description:</dt>
                <dd class="col-sm-9 text-secondary">@(string.IsNullOrEmpty(Model.Description) ? "None" : Model.Description)</dd>

                <dt class="col-sm-3 text-muted">Status:</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3 text-muted">Created Date:</dt>
                <dd class="col-sm-9 text-muted small">@(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")</dd>
            </dl>
        </div>
    </div>

    <!-- Products in this category -->
    <div class="card shadow-sm border-1 rounded-2">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-box-seam text-primary me-2"></i> Products in @Model.CategoryName (@products.Count)
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-3 py-2">SKU</th>
                            <th class="py-2">Product Name</th>
                            <th class="py-2 text-end">Price</th>
                            <th class="py-2 text-center">Stock</th>
                            <th class="py-2 text-center">Batches</th>
                            <th class="pe-3 py-2 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!products.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted small">
                                    No products registered in this category yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in products)
                            {
                                <tr>
                                    <td class="ps-3 font-monospace small">@p.Sku</td>
                                    <td class="fw-semibold">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId" class="text-dark text-decoration-none">
                                            @p.ProductName
                                        </a>
                                    </td>
                                    <td class="text-end font-monospace">$@p.SellingPrice.ToString("F2")</td>
                                    <td class="text-center">
                                        <span class="badge @(p.TotalStock <= 0 ? "bg-danger" : (p.TotalStock <= p.MinStockLevel ? "bg-warning text-dark" : "bg-success"))">
                                            @p.TotalStock @p.UnitOfMeasure
                                        </span>
                                    </td>
                                    <td class="text-center">@p.ActiveBatchCount</td>
                                    <td class="pe-3 text-end">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-xs btn-outline-secondary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

