@model IEnumerable<SuperMarket.Models.ViewModels.CategoryFormViewModel>

@{
    ViewData["Title"] = "Product Categories";
}

<div class="container my-4" style="max-width: 1000px;">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h3 class="mb-0 text-dark fw-normal">
                <i class="bi bi-tags text-primary me-2"></i> Product Categories
            </h3>
            <div class="text-muted small">Manage product classifications, sections, and department groupings.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-seam me-1"></i> Products List
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Category
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm border-1 rounded-2">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark">
                All Product Categories (@Model.Count())
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-secondary small fw-bold">
                            <th class="ps-4 py-3" style="min-width: 180px;">Category Name</th>
                            <th class="py-3">Description</th>
                            <th class="py-3 text-center" style="width: 140px;">Associated Products</th>
                            <th class="py-3 text-center" style="width: 110px;">Status</th>
                            <th class="pe-4 py-3 text-end" style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-tags fs-2 d-block mb-2 text-secondary"></i>
                                    No categories found.
                                    <div class="mt-2">
                                        <a asp-action="Create" class="btn btn-sm btn-primary">Create Your First Category</a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var cat in Model)
                            {
                                <tr>
                                    <!-- Name -->
                                    <td class="ps-4 fw-semibold text-dark">
                                        <div class="d-flex align-items-center">
                                            <span class="avatar-tag me-2">
                                                <i class="bi bi-tag text-primary"></i>
                                            </span>
                                            <a asp-action="Details" asp-route-id="@cat.CategoryId" class="text-dark text-decoration-none hover-primary">
                                                @cat.CategoryName
                                            </a>
                                        </div>
                                    </td>

                                    <!-- Description -->
                                    <td class="text-muted small">
                                        @(string.IsNullOrEmpty(cat.Description) ? "—" : cat.Description)
                                    </td>

                                    <!-- Products Count -->
                                    <td class="text-center">
                                        <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@cat.CategoryId" class="text-decoration-none">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-box-seam me-1"></i> @cat.ProductCount Product@(cat.ProductCount == 1 ? "" : "s")
                                            </span>
                                        </a>
                                    </td>

                                    <!-- Status -->
                                    <td class="text-center">
                                        @if (cat.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@cat.CategoryId" class="btn btn-outline-secondary" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@cat.CategoryId" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@cat.CategoryId" class="btn btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-tag {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background-color: #f0f4ff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
    }
    .hover-primary:hover {
        color: #0d6efd !important;
    }
</style>

