@model SuperMarket.Models.CustomerReturn
@{
    ViewData["Title"] = $"Customer Return #{Model.ReturnId}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-arrow-return-left text-danger me-2"></i>Customer Return #@Model.ReturnId</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row g-3">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-info-circle me-2"></i>Return Details</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Return Date</dt>
                    <dd class="col-sm-7">@Model.ReturnDate?.ToString("MMM d, yyyy HH:mm")</dd>
                    
                    <dt class="col-sm-5">Sale ID</dt>
                    <dd class="col-sm-7">@(Model.SaleId > 0 ? $"#{Model.SaleId}" : "N/A")</dd>

                    <dt class="col-sm-5">Refund Amount</dt>
                    <dd class="col-sm-7 fw-bold text-danger">$@Model.RefundAmount.ToString("N2")</dd>

                    <dt class="col-sm-5">Processed By</dt>
                    <dd class="col-sm-7">@(Model.ProcessedByUser?.FullName ?? $"User #{Model.ProcessedByUserId}")</dd>

                    <dt class="col-sm-5">Reason</dt>
                    <dd class="col-sm-7">@Model.Reason</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold"><i class="bi bi-boxes me-2"></i>Returned Items (@Model.CustomerReturnItems.Count)</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Batch</th>
                                <th>Condition</th>
                                <th class="text-end">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CustomerReturnItems)
                            {
                                var badgeClass = item.RestockCondition switch
                                {
                                    "Resalable" => "bg-success",
                                    "Damaged" => "bg-danger",
                                    "Expired" => "bg-warning text-dark",
                                    "Quarantine" => "bg-secondary",
                                    _ => "bg-info"
                                };
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@(item.Product?.ProductName ?? $"Product #{item.ProductId}")</div>
                                        <div class="text-muted small">@(item.Product?.Sku ?? "")</div>
                                    </td>
                                    <td>@(item.Batch?.BatchNumber ?? $"Batch #{item.BatchId}")</td>
                                    <td>
                                        <span class="badge @badgeClass">@item.RestockCondition</span>
                                    </td>
                                    <td class="text-end fw-bold">@item.Quantity.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="fw-bold text-end">Total Units:</td>
                                <td class="text-end fw-bold">@Model.CustomerReturnItems.Sum(i => i.Quantity).ToString("N0")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

