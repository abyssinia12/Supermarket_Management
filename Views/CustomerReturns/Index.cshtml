@model List<SuperMarket.Models.ViewModels.CustomerReturnListViewModel>
@{
    ViewData["Title"] = "Customer Returns";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-arrow-return-left text-danger me-2"></i>Customer Returns</h2>
    <a asp-action="Create" class="btn btn-danger btn-sm"><i class="bi bi-plus-circle me-1"></i>Record Return</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-arrow-return-left fs-1 d-block mb-2"></i>
                No returns recorded. <a asp-action="Create">Record one now.</a>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Return Date</th>
                        <th>Sale Ref</th>
                        <th>Reason</th>
                        <th>Items</th>
                        <th class="text-end">Refund</th>
                        <th>Processed By</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-muted small">#@r.ReturnId</td>
                            <td class="small">@r.ReturnDate?.ToString("MMM d, yyyy")</td>
                            <td class="small text-muted">@(r.SaleId.HasValue && r.SaleId > 0 ? $"Sale #{r.SaleId}" : "—")</td>
                            <td class="small" style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@r.Reason</td>
                            <td class="small">@r.ItemCount item(s) / @r.TotalQuantity.ToString("N0") units</td>
                            <td class="text-end fw-semibold">$@r.RefundAmount.ToString("N2")</td>
                            <td class="small text-muted">@r.ProcessedByUser</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.ReturnId" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

