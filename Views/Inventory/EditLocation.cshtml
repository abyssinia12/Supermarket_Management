@model SuperMarket.Models.ViewModels.LocationFormViewModel
@{
    ViewData["Title"] = "Edit Location";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-pencil text-warning me-2"></i>Edit Location</h2>
    <a asp-action="Locations" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card border-0 shadow-sm" style="max-width:500px">
    <div class="card-body">
        <form asp-action="EditLocation" asp-route-id="@Model.LocationId" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="LocationId" type="hidden" />
            <div class="mb-3">
                <label asp-for="LocationName" class="form-label fw-semibold">Location Name</label>
                <input asp-for="LocationName" class="form-control" />
                <span asp-validation-for="LocationName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LocationType" class="form-label fw-semibold">Type</label>
                <select asp-for="LocationType" class="form-select">
                    <option value="Store">Store</option>
                    <option value="Warehouse">Warehouse</option>
                    <option value="Branch">Branch</option>
                </select>
            </div>
            <div class="mb-3 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-check-circle me-1"></i>Save Changes</button>
                <a asp-action="Locations" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

