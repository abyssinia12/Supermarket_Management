@model SuperMarket.Models.ViewModels.StockValuationViewModel
@{
    ViewData["Title"] = "Inventory Valuation";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-currency-dollar text-success me-2"></i>Inventory Valuation</h2>
        <p class="text-muted mb-0 small">Generated at @Model.GeneratedAt.ToString("MMM d, yyyy HH:mm")</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small mb-1">Cost Value (Inventory)</div>
            <div class="fs-3 fw-bold text-success">$@Model.GrandTotal.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small mb-1">Est. Retail Value</div>
            <div class="fs-3 fw-bold text-primary">$@Model.EstimatedRetailValue.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="text-muted small mb-1">Est. Gross Margin</div>
            <div class="fs-3 fw-bold text-warning">$@Model.EstimatedMargin.ToString("N2")</div>
        </div>
    </div>
</div>

@if (!Model.Locations.Any())
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>No stock data available for valuation.</div>
}

@foreach (var loc in Model.Locations)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
            <div>
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-geo-alt me-2"></i>@loc.LocationName
                    <span class="badge @(loc.LocationType == "Warehouse" ? "bg-primary" : loc.LocationType == "Branch" ? "bg-info" : "bg-secondary") ms-2">@loc.LocationType</span>
                </h6>
            </div>
            <div class="fw-bold text-success">Subtotal: $@loc.Subtotal.ToString("N2")</div>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Batch</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Total Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in loc.Lines)
                    {
                        <tr>
                            <td class="fw-semibold small">@line.ProductName</td>
                            <td class="text-muted small">@line.Sku</td>
                            <td class="text-muted small">@(line.BatchNumber ?? "—")</td>
                            <td class="text-end">@line.Quantity.ToString("N0")</td>
                            <td class="text-end text-muted">$@line.UnitCost.ToString("N4")</td>
                            <td class="text-end fw-semibold">$@line.TotalValue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="5" class="fw-bold text-end">Location Subtotal:</td>
                        <td class="text-end fw-bold text-success">$@loc.Subtotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<div class="card border-0 shadow-sm bg-success text-white">
    <div class="card-body d-flex justify-content-between align-items-center py-3">
        <span class="fs-5 fw-bold"><i class="bi bi-calculator me-2"></i>Grand Total (All Locations)</span>
        <span class="fs-4 fw-bold">$@Model.GrandTotal.ToString("N2")</span>
    </div>
</div>

