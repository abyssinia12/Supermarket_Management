@model SuperMarket.Models.ViewModels.InventoryTransactionListViewModel
@{
    ViewData["Title"] = $"Transaction #{Model.TransactionId}";
    var typeColor = Model.TransactionType switch
    {
        "Purchase" => "success",
        "Sale" => "primary",
        "Adjustment" => "warning",
        "TransferOut" => "secondary",
        "TransferIn" => "info",
        "Return" => "danger",
        "OpeningStock" => "dark",
        _ => "secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-journal-bookmark text-dark me-2"></i>Transaction #@Model.TransactionId</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back to Ledger</a>
</div>

<div class="alert alert-danger d-flex align-items-center mb-3">
    <i class="bi bi-shield-lock-fill me-2 fs-5"></i>
    <div><strong>This record cannot be modified.</strong> Inventory transactions are immutable to preserve audit integrity.</div>
</div>

<div class="card border-0 shadow-sm" style="max-width:600px">
    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Transaction Details</span>
        <span class="badge bg-@typeColor fs-6">@Model.TransactionType</span>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Transaction ID</dt><dd class="col-sm-8">#@Model.TransactionId</dd>
            <dt class="col-sm-4">Timestamp</dt><dd class="col-sm-8">@Model.Timestamp?.ToString("MMM d, yyyy HH:mm:ss")</dd>
            <dt class="col-sm-4">Type</dt><dd class="col-sm-8"><span class="badge bg-@typeColor">@Model.TransactionType</span></dd>
            <dt class="col-sm-4">Product</dt><dd class="col-sm-8 fw-semibold">@Model.ProductName</dd>
            <dt class="col-sm-4">SKU</dt><dd class="col-sm-8 text-muted">@Model.ProductSku</dd>
            <dt class="col-sm-4">Batch</dt><dd class="col-sm-8">@(Model.BatchNumber ?? "—")</dd>
            <dt class="col-sm-4">Location</dt><dd class="col-sm-8">@Model.LocationName</dd>
            <dt class="col-sm-4">Quantity Δ</dt>
            <dd class="col-sm-8 fw-bold fs-5 @(Model.QuantityDelta >= 0 ? "text-success" : "text-danger")">
                @(Model.QuantityDelta >= 0 ? "+" : "")@Model.QuantityDelta.ToString("N3")
            </dd>
            <dt class="col-sm-4">User</dt><dd class="col-sm-8">@Model.UserName</dd>
            <dt class="col-sm-4">Reference ID</dt><dd class="col-sm-8">@(Model.ReferenceId.HasValue ? $"#{Model.ReferenceId}" : "—")</dd>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <dt class="col-sm-4">Notes</dt><dd class="col-sm-8">@Model.Notes</dd>
            }
        </dl>
    </div>
</div>

