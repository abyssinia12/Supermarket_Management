@model SuperMarket.Models.ViewModels.InventoryTransactionFilterViewModel
@{
    ViewData["Title"] = "Transaction Ledger";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-journal-text text-dark me-2"></i>Transaction Ledger</h2>
        <p class="text-muted mb-0 small">@Model.Transactions.Count records</p>
    </div>
</div>

<div class="alert alert-secondary d-flex align-items-center mb-3" role="alert">
    <i class="bi bi-lock-fill me-2 fs-5"></i>
    <div><strong>Immutable Ledger</strong> — Transaction records cannot be edited or deleted. This ensures full audit integrity.</div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Type</label>
                <select name="type" class="form-select form-select-sm" asp-items="Model.AvailableTypes">
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Product</label>
                <select name="productId" class="form-select form-select-sm" asp-items="Model.AvailableProducts">
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Location</label>
                <select name="locationId" class="form-select form-select-sm" asp-items="Model.AvailableLocations">
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">From Date</label>
                <input type="date" name="dateFrom" class="form-control form-control-sm" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">To Date</label>
                <input type="date" name="dateTo" class="form-control form-control-sm" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Transactions.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-text fs-1 d-block mb-2"></i>
                No transactions match the selected filters.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-sm">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Timestamp</th>
                            <th>Type</th>
                            <th>Product</th>
                            <th>Batch</th>
                            <th>Location</th>
                            <th class="text-end">Qty Δ</th>
                            <th>User</th>
                            <th>Ref</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            var typeColor = t.TransactionType switch
                            {
                                "Purchase" => "success",
                                "Sale" => "primary",
                                "Adjustment" => "warning",
                                "TransferOut" => "secondary",
                                "TransferIn" => "info",
                                "Return" => "danger",
                                "OpeningStock" => "dark",
                                _ => "secondary"
                            };
                            <tr>
                                <td class="text-muted small">@t.TransactionId</td>
                                <td class="small text-muted">@t.Timestamp?.ToString("MMM d, HH:mm")</td>
                                <td><span class="badge bg-@typeColor">@t.TransactionType</span></td>
                                <td>
                                    <div class="small fw-semibold">@t.ProductName</div>
                                    <div class="text-muted" style="font-size:11px">@t.ProductSku</div>
                                </td>
                                <td class="small text-muted">@(t.BatchNumber ?? "—")</td>
                                <td class="small">@t.LocationName</td>
                                <td class="text-end fw-bold @(t.QuantityDelta >= 0 ? "text-success" : "text-danger")">
                                    @(t.QuantityDelta >= 0 ? "+" : "")@t.QuantityDelta.ToString("N3")
                                </td>
                                <td class="small text-muted">@t.UserName</td>
                                <td class="small text-muted">@(t.ReferenceId.HasValue ? $"#{t.ReferenceId}" : "—")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@t.TransactionId" class="btn btn-link btn-sm p-0 text-muted">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

