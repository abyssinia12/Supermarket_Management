@model IEnumerable<SuperMarket.Models.Location>

@{
    ViewData["Title"] = "Location Management";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Location Management</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item active">Locations</li>
    </ol>

    <!-- Success / Error Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Add Location Form -->
        <div class="col-md-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-dark text-white">Add New Location</div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label">Location Name</label>
                            <input type="text" name="locationName" class="form-control" required placeholder="e.g., Main Warehouse" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Location Type</label>
                            <select name="locationType" class="form-select" required>
                                <option value="Warehouse">Warehouse</option>
                                <option value="Shop">Shop Floor</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Save Location</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Locations Table -->
        <div class="col-md-8">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-dark text-white">Existing Storage Locations</div>
                <div class="card-body">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No locations created yet. Add one to get started.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><strong>@item.LocationName</strong></td>
                                        <td>
                                            <span class="badge @(item.LocationType == "Warehouse" ? "bg-info text-dark" : "bg-success")">
                                                @item.LocationType
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.IsActive ?? true)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.LocationId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm @((item.IsActive ?? true) ? "btn-outline-danger" : "btn-outline-success")">
                                                    @((item.IsActive ?? true) ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>