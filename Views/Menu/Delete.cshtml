@model SuperMarket.Models.Menu

@{
    ViewData["Title"] = "Delete Menu Item";
}

<div class="container my-4" style="max-width: 650px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Menu</a></li>
            <li class="breadcrumb-item active" aria-current="page">Delete Confirmation</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Menu Item Confirmation
            </h5>
            <a asp-action="Index" class="btn btn-sm btn-light">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
        <div class="card-body p-4">
            <p class="text-danger fw-semibold fs-6">
                Are you sure you want to permanently delete this menu item from the system?
            </p>

            <div class="p-3 bg-light rounded border mb-4">
                <div class="row g-2">
                    <div class="col-sm-4 text-muted">Title:</div>
                    <div class="col-sm-8 fw-bold text-dark">@Model.Title</div>

                    <div class="col-sm-4 text-muted">Controller:</div>
                    <div class="col-sm-8">@Model.Controller</div>

                    <div class="col-sm-4 text-muted">Action:</div>
                    <div class="col-sm-8">@Model.Action</div>

                    <div class="col-sm-4 text-muted">Category:</div>
                    <div class="col-sm-8">@Model.MenuCategory</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MenuId" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-1"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

