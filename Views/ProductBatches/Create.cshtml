@model SuperMarket.Models.ViewModels.BatchFormViewModel

@{
    ViewData["Title"] = "Record Product Batch";
}

<div class="container my-4" style="max-width: 750px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Batches</a></li>
            <li class="breadcrumb-item active" aria-current="page">Record New Batch</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-1 rounded-2">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">
                <i class="bi bi-boxes text-primary me-2"></i> Record New Product Batch
            </h5>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Batches
            </a>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <!-- Product Selection -->
                    <div class="col-md-12">
                        <label asp-for="ProductId" class="form-label fw-semibold">
                            Select Product <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ProductId" class="form-select" asp-items="Model.AvailableProducts">
                            <option value="">-- Choose Product to Batch --</option>
                        </select>
                        <span asp-validation-for="ProductId" class="text-danger small"></span>
                    </div>

                    <!-- Batch Number -->
                    <div class="col-md-6">
                        <label asp-for="BatchNumber" class="form-label fw-semibold">
                            Batch Number <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input asp-for="BatchNumber" id="inputBatchNumber" class="form-control font-monospace text-uppercase" placeholder="e.g. BATCH-2026-001" />
                            <button type="button" class="btn btn-outline-secondary" id="btnGenBatch">
                                <i class="bi bi-arrow-repeat"></i> Auto
                            </button>
                        </div>
                        <span asp-validation-for="BatchNumber" class="text-danger small"></span>
                        <div class="form-text">Unique lot or batch number printed on manufacturer packaging.</div>
                    </div>

                    <!-- Unit Cost -->
                    <div class="col-md-6">
                        <label asp-for="UnitCost" class="form-label fw-semibold">
                            Batch Unit Cost ($) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="UnitCost" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                        <span asp-validation-for="UnitCost" class="text-danger small"></span>
                    </div>

                    <!-- Manufacture Date -->
                    <div class="col-md-6">
                        <label asp-for="ManufactureDate" class="form-label fw-semibold">Manufacture Date</label>
                        <input asp-for="ManufactureDate" type="date" class="form-control" />
                        <span asp-validation-for="ManufactureDate" class="text-danger small"></span>
                    </div>

                    <!-- Expiration Date -->
                    <div class="col-md-6">
                        <label asp-for="ExpirationDate" class="form-label fw-semibold">Expiration Date</label>
                        <input asp-for="ExpirationDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpirationDate" class="text-danger small"></span>
                        <div class="form-text">Used for FEFO (First-Expired, First-Out) inventory tracking.</div>
                    </div>

                    <!-- Stock Quantity -->
                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label fw-semibold">
                            Quantity Available in this Batch <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Quantity" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                        <div class="form-text">Automatically recorded into available stock.</div>
                    </div>

                    <!-- Storage Location -->
                    <div class="col-md-6">
                        <label asp-for="LocationId" class="form-label fw-semibold">Storage Location</label>
                        <select asp-for="LocationId" class="form-select" asp-items="Model.AvailableLocations">
                            <option value="">-- Default Location --</option>
                        </select>
                        <span asp-validation-for="LocationId" class="text-danger small"></span>
                    </div>

                    <!-- Active Toggle -->
                    <div class="col-12">
                        <div class="form-check form-switch pt-1">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch" />
                            <label class="form-check-label fw-semibold" for="activeSwitch">
                                Batch is Active
                            </label>
                        </div>
                    </div>

                    <!-- Submit Actions -->
                    <div class="col-12 d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Save Batch & Record Stock
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById('btnGenBatch').addEventListener('click', function () {
            var dateStr = new Date().toISOString().slice(0, 10).replace(/-/g, '');
            var rand = Math.floor(100 + Math.random() * 900);
            document.getElementById('inputBatchNumber').value = 'BATCH-' + dateStr + '-' + rand;
        });
    </script>
}

