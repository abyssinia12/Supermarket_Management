@model SuperMarket.Models.ViewModels.BatchItemViewModel

@{
    ViewData["Title"] = "Delete Batch: " + Model.BatchNumber;
}

<div class="container my-4" style="max-width: 600px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Batches</a></li>
            <li class="breadcrumb-item active" aria-current="page">Delete Confirmation</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Batch Confirmation
            </h5>
            <a asp-action="Index" class="btn btn-sm btn-light">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
        <div class="card-body p-4">
            <p class="text-danger fw-semibold fs-6">
                Are you sure you want to delete this batch and its associated stock?
            </p>

            <div class="p-3 bg-light rounded border mb-4 small">
                <div class="row g-2">
                    <div class="col-sm-4 text-muted">Batch Number:</div>
                    <div class="col-sm-8 font-monospace fw-bold text-dark">@Model.BatchNumber</div>

                    <div class="col-sm-4 text-muted">Product:</div>
                    <div class="col-sm-8 fw-semibold">@Model.ProductName</div>

                    <div class="col-sm-4 text-muted">Stock Quantity:</div>
                    <div class="col-sm-8 font-monospace text-danger fw-bold">@Model.TotalQuantity Units will be removed</div>

                    <div class="col-sm-4 text-muted">Expiry Date:</div>
                    <div class="col-sm-8">@(Model.ExpirationDate.HasValue ? Model.ExpirationDate.Value.ToString("yyyy-MM-dd") : "None")</div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.BatchId" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-1"></i> Delete Batch
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

