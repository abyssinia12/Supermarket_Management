@model SuperMarket.Models.ViewModels.BatchItemViewModel

@{
    ViewData["Title"] = "Batch Details - " + Model.BatchNumber;
}

<div class="container my-4" style="max-width: 650px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Batches</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.BatchNumber</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-1 rounded-2">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">
                <i class="bi bi-box text-primary me-2"></i> Batch: <span class="fw-bold font-monospace">@Model.BatchNumber</span>
            </h5>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.BatchId" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <dl class="row mb-0 g-2">
                <dt class="col-sm-4 text-muted">Product:</dt>
                <dd class="col-sm-8 fw-bold">
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="text-decoration-none">
                        @Model.ProductName
                    </a>
                    <div class="font-monospace text-muted small">@Model.ProductSku</div>
                </dd>

                <dt class="col-sm-4 text-muted">Batch Number:</dt>
                <dd class="col-sm-8 font-monospace fw-bold">@Model.BatchNumber</dd>

                <dt class="col-sm-4 text-muted">Available Quantity:</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-primary fs-6 px-3 py-1">@Model.TotalQuantity Units</span>
                </dd>

                <dt class="col-sm-4 text-muted">Unit Cost:</dt>
                <dd class="col-sm-8 font-monospace">$@Model.UnitCost.ToString("F2")</dd>

                <dt class="col-sm-4 text-muted">Manufacture Date:</dt>
                <dd class="col-sm-8 font-monospace">@(Model.ManufactureDate.HasValue ? Model.ManufactureDate.Value.ToString("yyyy-MM-dd") : "—")</dd>

                <dt class="col-sm-4 text-muted">Expiration Date:</dt>
                <dd class="col-sm-8">
                    @if (Model.ExpirationDate.HasValue)
                    {
                        <span class="font-monospace">@Model.ExpirationDate.Value.ToString("yyyy-MM-dd")</span>
                        @if (Model.ExpiryStatus == "Expired")
                        {
                            <span class="badge bg-danger ms-1">Expired</span>
                        }
                        else if (Model.ExpiryStatus == "Expiring Soon")
                        {
                            <span class="badge bg-warning text-dark ms-1">Expiring in @Model.DaysUntilExpiry days</span>
                        }
                        else
                        {
                            <span class="badge bg-success ms-1">Good</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">Status:</dt>
                <dd class="col-sm-8">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">Created Date:</dt>
                <dd class="col-sm-8 text-muted small">@(Model.CreatedAt.HasValue ? Model.CreatedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")</dd>
            </dl>
        </div>
    </div>
</div>

