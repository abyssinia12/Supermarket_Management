@model SuperMarket.Models.ViewModels.BatchFormViewModel

@{
    ViewData["Title"] = "Edit Batch: " + Model.BatchNumber;
}

<div class="container my-4" style="max-width: 750px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Batches</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit: @Model.BatchNumber</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-1 rounded-2">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">
                <i class="bi bi-pencil-square text-primary me-2"></i> Edit Batch: <span class="fw-bold font-monospace">@Model.BatchNumber</span>
            </h5>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Batches
            </a>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="BatchId" />
                <input type="hidden" asp-for="ProductId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <!-- Product Info (Read-only on edit) -->
                    <div class="col-md-12">
                        <label class="form-label fw-semibold text-muted">Product</label>
                        <div class="p-2 bg-light rounded border fw-semibold text-dark">
                            @Model.ProductName <span class="font-monospace text-muted ms-2">(@Model.ProductSku)</span>
                        </div>
                    </div>

                    <!-- Batch Number -->
                    <div class="col-md-6">
                        <label asp-for="BatchNumber" class="form-label fw-semibold">
                            Batch Number <span class="text-danger">*</span>
                        </label>
                        <input asp-for="BatchNumber" class="form-control font-monospace text-uppercase" />
                        <span asp-validation-for="BatchNumber" class="text-danger small"></span>
                    </div>

                    <!-- Unit Cost -->
                    <div class="col-md-6">
                        <label asp-for="UnitCost" class="form-label fw-semibold">
                            Batch Unit Cost ($) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="UnitCost" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                        <span asp-validation-for="UnitCost" class="text-danger small"></span>
                    </div>

                    <!-- Manufacture Date -->
                    <div class="col-md-6">
                        <label asp-for="ManufactureDate" class="form-label fw-semibold">Manufacture Date</label>
                        <input asp-for="ManufactureDate" type="date" class="form-control" />
                        <span asp-validation-for="ManufactureDate" class="text-danger small"></span>
                    </div>

                    <!-- Expiration Date -->
                    <div class="col-md-6">
                        <label asp-for="ExpirationDate" class="form-label fw-semibold">Expiration Date</label>
                        <input asp-for="ExpirationDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpirationDate" class="text-danger small"></span>
                    </div>

                    <!-- Quantity -->
                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label fw-semibold">
                            Current Available Quantity <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Quantity" type="number" step="1" min="0" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                        <div class="form-text">Adjust available stock count for this batch.</div>
                    </div>

                    <!-- Active Toggle -->
                    <div class="col-12">
                        <div class="form-check form-switch pt-1">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch" />
                            <label class="form-check-label fw-semibold" for="activeSwitch">
                                Batch is Active
                            </label>
                        </div>
                    </div>

                    <!-- Submit Actions -->
                    <div class="col-12 d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Delete" asp-route-id="@Model.BatchId" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash me-1"></i> Delete Batch
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-check-lg me-1"></i> Update Batch
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

