@model SuperMarket.Models.ViewModels.ProductFormViewModel

@{
    ViewData["Title"] = "Edit Product: " + Model.ProductName;
}

<div class="container my-4" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ProductId">@Model.ProductName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit Product</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-1 rounded-2">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">
                <i class="bi bi-pencil-square text-primary me-2"></i> Edit Product: <span class="fw-bold">@Model.ProductName</span>
            </h5>
            <div class="d-flex gap-2">
                <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-eye me-1"></i> View Details
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post" id="editProductForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProductId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Section 1: Basic Identifiers -->
                <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-upc-scan text-primary me-1"></i> Product Identification & Details
                    </h6>
                    <div class="row g-3">
                        <!-- Product Name -->
                        <div class="col-md-12">
                            <label asp-for="ProductName" class="form-label fw-semibold">
                                Product Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ProductName" class="form-control" />
                            <span asp-validation-for="ProductName" class="text-danger small"></span>
                        </div>

                        <!-- Product Code (SKU) -->
                        <div class="col-md-6">
                            <label asp-for="Sku" class="form-label fw-semibold">
                                Unique Product Code (SKU) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Sku" class="form-control font-monospace text-uppercase" />
                            <span asp-validation-for="Sku" class="text-danger small"></span>
                        </div>

                        <!-- Barcode -->
                        <div class="col-md-6">
                            <label asp-for="Barcode" class="form-label fw-semibold">
                                Barcode / UPC / EAN <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Barcode" class="form-control font-monospace" />
                            <span asp-validation-for="Barcode" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label fw-semibold">Product Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detailed product description, notes, specifications..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Classification & Pricing -->
                <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-tag text-primary me-1"></i> Categorization & Pricing
                    </h6>
                    <div class="row g-3">
                        <!-- Category -->
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                Product Category <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId" class="form-select" asp-items="Model.AvailableCategories"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Unit of Measure -->
                        <div class="col-md-6">
                            <label asp-for="UnitOfMeasure" class="form-label fw-semibold">
                                Unit of Measure (UOM) <span class="text-danger">*</span>
                            </label>
                            <select asp-for="UnitOfMeasure" class="form-select">
                                @foreach (var uom in Model.AvailableUnits)
                                {
                                    <option value="@uom" selected="@(Model.UnitOfMeasure == uom ? "selected" : null)">@uom</option>
                                }
                            </select>
                            <span asp-validation-for="UnitOfMeasure" class="text-danger small"></span>
                        </div>

                        <!-- Purchase Cost -->
                        <div class="col-md-4">
                            <label asp-for="PurchaseCost" class="form-label fw-semibold">
                                Purchase Cost ($) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PurchaseCost" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="PurchaseCost" class="text-danger small"></span>
                        </div>

                        <!-- Selling Price -->
                        <div class="col-md-4">
                            <label asp-for="SellingPrice" class="form-label fw-semibold">
                                Selling Price ($) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="SellingPrice" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="SellingPrice" class="text-danger small"></span>
                        </div>

                        <!-- Min Stock Level -->
                        <div class="col-md-4">
                            <label asp-for="MinStockLevel" class="form-label fw-semibold">
                                Min Stock Alert Level <span class="text-danger">*</span>
                            </label>
                            <input asp-for="MinStockLevel" type="number" min="0" class="form-control" />
                            <span asp-validation-for="MinStockLevel" class="text-danger small"></span>
                        </div>

                        <!-- Active Toggle -->
                        <div class="col-12">
                            <div class="form-check form-switch pt-1">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch" />
                                <label class="form-check-label fw-semibold" for="activeSwitch">
                                    Product is Active and available in inventory
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Submit Actions -->
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash me-1"></i> Delete Product
                    </a>
                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Update Product
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

