@model SuperMarket.Models.Role

@{
    ViewData["Title"] = "Delete Role Confirmation";
    var assignedMenus = ViewBag.AssignedMenus as List<SuperMarket.Models.Menu> ?? new List<SuperMarket.Models.Menu>();
}

<div class="container my-4" style="max-width: 650px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Roles</a></li>
            <li class="breadcrumb-item active" aria-current="page">Delete Confirmation</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Role Confirmation
            </h5>
            <a asp-action="Index" class="btn btn-sm btn-light">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
        <div class="card-body p-4">
            <p class="text-danger fw-semibold fs-6">
                Are you sure you want to delete this role from the system?
            </p>

            <div class="p-3 bg-light rounded border mb-4">
                <div class="row g-2">
                    <div class="col-sm-4 text-muted">Role Title:</div>
                    <div class="col-sm-8 fw-bold text-dark fs-6">@Model.RoleName</div>

                    <div class="col-sm-4 text-muted">Description:</div>
                    <div class="col-sm-8 text-secondary">@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</div>

                    <div class="col-sm-4 text-muted">Status:</div>
                    <div class="col-sm-8">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </div>

                    <div class="col-sm-4 text-muted">Assigned Menus:</div>
                    <div class="col-sm-8">
                        <span class="badge bg-primary">@assignedMenus.Count Menus</span>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RoleId" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-1"></i> Delete Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
