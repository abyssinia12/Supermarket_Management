<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SuperMarket</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuperMarket.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SuperMarket</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login Page</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-semibold" href="#" id="inventoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-box-seam text-primary me-1"></i> Products
                            </a>
                            <ul class="dropdown-menu shadow-sm" aria-labelledby="inventoryDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam text-primary me-2"></i>All Products & Stock</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-circle text-success me-2"></i>Add New Product</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags text-secondary me-2"></i>Categories</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="ProductBatches" asp-action="Index"><i class="bi bi-boxes text-info me-2"></i>Batch Management</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Roles" asp-action="Index">Roles Page</a>
                        </li>
                        <li class="nav-item">
                            @* <a class="nav-link text-dark" asp-area="" asp-controller="Roles" asp-action="CreatePermission">Permission Page</a> *@
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Permissions" asp-action="CreatePermission">Permission Create</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold text-primary" asp-area="" asp-controller="Menu" asp-action="Index">Menu</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-semibold" href="#" id="invMgmtDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-clipboard-data text-warning me-1"></i> Inventory
                            </a>
                            <ul class="dropdown-menu shadow-sm" aria-labelledby="invMgmtDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Inventory" asp-action="Index"><i class="bi bi-speedometer2 text-primary me-2"></i>Stock Dashboard</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Inventory" asp-action="StockByLocation"><i class="bi bi-geo-alt text-info me-2"></i>Stock by Location</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Inventory" asp-action="Valuation"><i class="bi bi-currency-dollar text-success me-2"></i>Inventory Valuation</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" asp-controller="StockAdjustments" asp-action="Index"><i class="bi bi-pencil-square text-warning me-2"></i>Stock Adjustments</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="StockTransfers" asp-action="Index"><i class="bi bi-arrow-left-right text-secondary me-2"></i>Stock Transfers</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="InventoryTransactions" asp-action="Index"><i class="bi bi-journal-text text-dark me-2"></i>Transaction Ledger</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="CustomerReturns" asp-action="Index"><i class="bi bi-arrow-return-left text-danger me-2"></i>Customer Returns</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" asp-controller="Inventory" asp-action="Locations"><i class="bi bi-building me-2"></i>Manage Locations</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SuperMarket - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
