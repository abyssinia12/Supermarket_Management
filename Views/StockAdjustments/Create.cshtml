@model SuperMarket.Models.ViewModels.StockAdjustmentFormViewModel
@{
    ViewData["Title"] = "New Stock Adjustment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-pencil-square text-warning me-2"></i>New Stock Adjustment</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card border-0 shadow-sm" style="max-width:650px">
    <div class="card-body">
        <div class="alert alert-info small mb-3">
            <i class="bi bi-info-circle me-2"></i>Adjustments require approval before stock is updated.
            Use negative quantities to reduce stock (Damage, Loss, Expiry).
        </div>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label fw-semibold">Product</label>
                <select asp-for="ProductId" asp-items="Model.AvailableProducts" class="form-select" id="productSelect">
                    <option value="">— Select Product —</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BatchId" class="form-label fw-semibold">Batch</label>
                <select asp-for="BatchId" asp-items="Model.AvailableBatches" class="form-select" id="batchSelect">
                    <option value="">— Select Product first —</option>
                </select>
                <span asp-validation-for="BatchId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LocationId" class="form-label fw-semibold">Location</label>
                <select asp-for="LocationId" asp-items="Model.AvailableLocations" class="form-select">
                    <option value="">— Select Location —</option>
                </select>
                <span asp-validation-for="LocationId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AdjustmentType" class="form-label fw-semibold">Adjustment Type</label>
                <select asp-for="AdjustmentType" class="form-select">
                    <option value="">— Select Type —</option>
                    <option value="Damage">Damage</option>
                    <option value="Loss">Loss</option>
                    <option value="Expiry">Expiry</option>
                    <option value="Correction">Correction</option>
                    <option value="Count">Count Adjustment</option>
                </select>
                <span asp-validation-for="AdjustmentType" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                <input asp-for="Quantity" class="form-control" type="number" step="0.001" placeholder="Use negative for removal (e.g. -5)" />
                <div class="form-text">Use negative values to remove stock. Positive to add.</div>
                <span asp-validation-for="Quantity" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Reason" class="form-label fw-semibold">Reason</label>
                <textarea asp-for="Reason" class="form-control" rows="2" placeholder="Explain the reason for this adjustment"></textarea>
                <span asp-validation-for="Reason" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Notes" class="form-label fw-semibold">Additional Notes <span class="text-muted">(optional)</span></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning"><i class="bi bi-send me-1"></i>Submit for Approval</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.getElementById('productSelect').addEventListener('change', function () {
            var productId = this.value;
            var batchSelect = document.getElementById('batchSelect');
            batchSelect.innerHTML = '<option value="">Loading...</option>';
            if (!productId) { batchSelect.innerHTML = '<option value="">— Select Product first —</option>'; return; }
            fetch('/StockAdjustments/GetBatchesForProduct?productId=' + productId)
                .then(r => r.json())
                .then(data => {
                    batchSelect.innerHTML = '<option value="">— Select Batch —</option>';
                    data.forEach(b => {
                        var opt = document.createElement('option');
                        opt.value = b.value; opt.textContent = b.text;
                        batchSelect.appendChild(opt);
                    });
                }).catch(() => { batchSelect.innerHTML = '<option value="">Error loading batches</option>'; });
        });
    </script>
}

