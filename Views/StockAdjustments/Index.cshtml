@model List<SuperMarket.Models.ViewModels.StockAdjustmentListViewModel>
@{
    ViewData["Title"] = "Stock Adjustments";
    var currentStatus = ViewBag.StatusFilter as string;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-pencil-square text-warning me-2"></i>Stock Adjustments</h2>
    <a asp-action="Create" class="btn btn-warning btn-sm"><i class="bi bi-plus-circle me-1"></i>New Adjustment</a>
</div>

<!-- Status filter tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(string.IsNullOrEmpty(currentStatus) ? "active" : "")" asp-action="Index">All</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "Pending" ? "active" : "")" asp-action="Index" asp-route-status="Pending">
            Pending
            @{
                var pendingCount = Model.Count(a => a.Status == "Pending");
                if (string.IsNullOrEmpty(currentStatus) && pendingCount > 0)
                {
                    <span class="badge bg-warning text-dark ms-1">@pendingCount</span>
                }
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "Approved" ? "active" : "")" asp-action="Index" asp-route-status="Approved">Approved</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == "Rejected" ? "active" : "")" asp-action="Index" asp-route-status="Rejected">Rejected</a>
    </li>
</ul>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-pencil-square fs-1 d-block mb-2"></i>
                No adjustments found. <a asp-action="Create">Record one now.</a>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Batch</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th class="text-end">Qty</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Reported By</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var adj in Model)
                    {
                        <tr>
                            <td class="fw-semibold small">@adj.ProductName</td>
                            <td class="text-muted small">@(adj.BatchNumber ?? "—")</td>
                            <td class="small">@adj.LocationName</td>
                            <td>
                                @{
                                    var typeColor = adj.AdjustmentType switch
                                    {
                                        "Damage" => "danger",
                                        "Loss" => "danger",
                                        "Expiry" => "warning",
                                        "Correction" => "info",
                                        "Count" => "secondary",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@typeColor">@adj.AdjustmentType</span>
                            </td>
                            <td class="text-end fw-bold @(adj.Quantity < 0 ? "text-danger" : "text-success")">
                                @(adj.Quantity >= 0 ? "+" : "")@adj.Quantity.ToString("N0")
                            </td>
                            <td class="small text-muted" style="max-width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                @adj.Reason
                            </td>
                            <td>
                                @if (adj.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                                else if (adj.Status == "Approved") { <span class="badge bg-success">Approved</span> }
                                else { <span class="badge bg-danger">Rejected</span> }
                            </td>
                            <td class="small">@adj.ReportedByUser</td>
                            <td class="small text-muted">@adj.CreatedAt?.ToString("MMM d, yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@adj.AdjustmentId" class="btn btn-outline-secondary btn-sm me-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (adj.Status == "Pending")
                                {
                                    <form asp-action="Approve" asp-route-id="@adj.AdjustmentId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm me-1" title="Approve" onclick="return confirm('Approve this adjustment and update stock?')">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@adj.AdjustmentId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Reject">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

